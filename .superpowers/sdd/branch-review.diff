+        style={{
+          transformOrigin: 'left center',
+          backfaceVisibility: 'hidden',
+          transform: flipping ? 'rotateY(-180deg)' : 'rotateY(0deg)',
+          transition: `transform ${duration}ms cubic-bezier(0.4, 0, 0.2, 1)`,
