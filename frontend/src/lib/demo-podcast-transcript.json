[
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u5404\u4f4d\u542c\u4f17\u5927\u5bb6\u597d\uff0c\u6b22\u8fce\u6765\u5230\u4eca\u5929\u7684\u6280\u672f\u5bf9\u8c08\u8282\u76ee\uff0c\u6211\u662f\u6653\u660e\u3002"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u5927\u5bb6\u597d\u6211\u662f\u9648\u535a\u58eb\u3002\u6700\u8fd1\u6536\u5230\u597d\u591a\u542c\u4f17\u7559\u8a00\uff0c\u8bf4\u521a\u63a5\u89e6\u673a\u5668\u5b66\u4e60\u5165\u95e8\u7684\u65f6\u5019\u7279\u522b\u5934\u75bc\uff0c\u77e5\u8bc6\u70b9\u592a\u6563\u4e86\uff0c\u4e00\u4f1a\u5237\u5230\u4e00\u7bc7\u8bb2\u635f\u5931\u51fd\u6570\u7684\u535a\u5ba2\uff0c\u4e00\u4f1a\u5237\u5230\u4e2a\u8bb2Transformer\u7684\u77ed\u89c6\u9891\uff0c\u4e1c\u62fc\u897f\u51d1\u5b66\u4e86\u597d\u4e45\uff0c\u8111\u5b50\u91cc\u7684\u77e5\u8bc6\u70b9\u8fd8\u662f\u96f6\u96f6\u788e\u788e\u4e32\u4e0d\u8d77\u6765\u3002"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u592a\u6709\u5171\u9e23\u4e86\uff01\u6211\u521a\u5165\u884c\u505aAI\u9879\u76ee\u7684\u65f6\u5019\u4e5f\u662f\u8e29\u8fc7\u8fd9\u4e2a\u5751\uff0c\u597d\u591a\u6838\u5fc3\u7684\u5e95\u5c42\u903b\u8f91\u6ca1\u6253\u901a\uff0c\u505a\u9879\u76ee\u7684\u65f6\u5019\u8981\u4e48\u8bc4\u4f30\u6307\u6807\u9009\u4e0d\u5bf9\u95f9\u4e86\u5927\u7b11\u8bdd\uff0c\u8981\u4e48\u5199\u8bad\u7ec3\u811a\u672c\u4e00\u8dd1\u5168\u662fbug\uff0c\u8e29\u4e86\u65e0\u6570\u6b21\u5751\u624d\u6478\u6e05\u695a\u95e8\u9053\u3002"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u6240\u4ee5\u4eca\u5929\u8fd9\u671f\u6211\u4eec\u5c31\u4e13\u95e8\u628a\u6574\u4e2a\u5165\u95e8\u9636\u6bb5\u7684\u6838\u5fc3\u77e5\u8bc6\u70b9\u7ed9\u5927\u5bb6\u4e32\u6210\u4e00\u6761\u5b8c\u6574\u7684\u4e3b\u7ebf\uff0c\u4ece\u6700\u57fa\u7840\u7684\u673a\u5668\u5b66\u4e60\u5b9a\u4e49\u3001\u76d1\u7763\u5b66\u4e60\u7684\u6cdb\u5316\u8bc4\u4f30\u903b\u8f91\u8bb2\u8d77\uff0c\u9010\u5c42\u5f80\u4e0b\u7a7f\u900f\u68af\u5ea6\u4e0b\u964d\u3001\u53cd\u5411\u4f20\u64ad\u8fd9\u4e9b\u9ed1\u7bb1\u539f\u7406\uff0c\u518d\u987a\u7740\u65f6\u95f4\u7ebf\u68b3\u7406\u4ece\u5168\u8fde\u63a5\u7f51\u7edc\u5230Transformer\u7684\u6574\u4e2a\u67b6\u6784\u6f14\u8fdb\u601d\u8def\uff0c\u6700\u540e\u843d\u5230\u5927\u5bb6\u6700\u5173\u5fc3\u7684PyTorch\u5b9e\u64cd\u907f\u5751\u5185\u5bb9\u4e0a\u3002"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u5bf9\uff0c\u8fd9\u671f\u5185\u5bb9\u6211\u4eec\u517c\u987e\u4e86\u5b66\u672f\u4e0a\u7684\u4e25\u8c28\u6027\u548c\u5de5\u7a0b\u843d\u5730\u7684\u5b9e\u64cd\u6027\uff0c\u5168\u7a0b\u6ca1\u6709\u5197\u4f59\u7684\u6982\u5ff5\u5806\u780c\uff0c\u65e2\u5e2e\u5927\u5bb6\u907f\u5f00\u5f88\u591a\u65b0\u624b\u5bb9\u6613\u8e29\u7684\u8ba4\u77e5\u8bef\u533a\uff0c\u4e5f\u7ed9\u5927\u5bb6\u68b3\u7406\u51fa\u4e00\u5957\u80fd\u76f4\u63a5\u7528\u5728\u9879\u76ee\u91cc\u7684\u5b8c\u6574\u65b9\u6cd5\u8bba\uff0c\u4e0d\u7ba1\u662f\u6b63\u5728\u4e0a\u8bfe\u7684\u8ba1\u7b97\u673a\u4e13\u4e1a\u540c\u5b66\uff0c\u8fd8\u662f\u6b63\u5728\u505a\u5f00\u53d1\u7684\u4e00\u7ebf\u5de5\u7a0b\u5e08\uff0c\u542c\u5b8c\u90fd\u80fd\u6709\u5b9e\u6253\u5b9e\u7684\u6536\u83b7\u3002\u90a3\u54b1\u4eec\u8bdd\u4e0d\u591a\u8bf4\uff0c\u76f4\u63a5\u8fdb\u5165\u6b63\u9898\u3002"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u90a3\u6211\u4eec\u5c31\u4ece\u6700\u57fa\u7840\u7684\u6838\u5fc3\u5b9a\u4e49\u804a\u8d77\uff0c\u5f88\u591a\u4eba\u5165\u95e8\u673a\u5668\u5b66\u4e60\u7ed5\u4e86\u5f88\u4e45\uff0c\u5176\u5b9e\u6700\u6839\u672c\u7684\u4e00\u53e5\u8bdd\u7279\u522b\u7b80\u5355\uff1a\u673a\u5668\u5b66\u4e60\u5c31\u662f\u8ba9\u8ba1\u7b97\u673a\u4ece\u6570\u636e\u91cc\u81ea\u52a8\u5b66\u4e60\u89c4\u5f8b\uff0c\u800c\u4e0d\u662f\u6211\u4eec\u4eba\u5de5\u628a\u6240\u6709\u89c4\u5219\u4e00\u6761\u6761\u786c\u7f16\u7801\u5199\u6b7b\u3002\u5f62\u5f0f\u5316\u70b9\u8bf4\uff0c\u5c31\u662f\u7ed9\u4f60\u4e00\u6279\u8bad\u7ec3\u6570\u636e\uff0c\u5b66\u4e00\u4e2a\u4ece\u8f93\u5165\u7a7a\u95f4\u5230\u8f93\u51fa\u7a7a\u95f4\u7684\u51fd\u6570\uff0c\u6700\u7ec8\u76ee\u6807\u662f\u5728\u4ece\u6765\u6ca1\u89c1\u8fc7\u7684\u65b0\u6570\u636e\u4e0a\u4e5f\u80fd\u505a\u51fa\u9760\u8c31\u9884\u6d4b\u3002\u6574\u4e2a\u9886\u57df\u73b0\u5728\u5206\u6210\u4e09\u5927\u4e3b\u6d41\u8303\u5f0f\uff1a\u6700\u5e38\u89c1\u7684\u76d1\u7763\u5b66\u4e60\u662f\u6240\u6709\u6570\u636e\u90fd\u5e26\u6807\u6ce8\u6807\u7b7e\uff0c\u5b66\u8f93\u5165\u5230\u8f93\u51fa\u7684\u6620\u5c04\uff0c\u7ec6\u5206\u51fa\u6765\u8f93\u51fa\u79bb\u6563\u7ed3\u679c\u7684\u53eb\u5206\u7c7b\uff0c\u8f93\u51fa\u8fde\u7eed\u6570\u503c\u7684\u53eb\u56de\u5f52\uff1b\u65e0\u76d1\u7763\u5b66\u4e60\u6570\u636e\u5b8c\u5168\u6ca1\u6709\u6807\u7b7e\uff0c\u4e13\u95e8\u7528\u6765\u6316\u6398\u6570\u636e\u5185\u5728\u7ed3\u6784\uff0c\u6bd4\u5982\u805a\u7c7b\u3001\u964d\u7ef4\uff1b\u8fd8\u6709\u4e00\u7c7b\u662f\u5f3a\u5316\u5b66\u4e60\uff0c\u667a\u80fd\u4f53\u901a\u8fc7\u548c\u73af\u5883\u4ea4\u4e92\u62ff\u5956\u52b1\uff0c\u6162\u6162\u6478\u7d22\u51fa\u6700\u4f18\u884c\u52a8\u7b56\u7565\u3002"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u8fd9\u70b9\u6211\u592a\u6709\u5171\u9e23\u4e86\uff01\u4e4b\u524d\u597d\u591a\u65b0\u4eba\u95ee\u6211\u4f20\u7edf\u7a0b\u5e8f\u548c\u673a\u5668\u5b66\u4e60\u7684\u533a\u522b\uff0c\u6211\u5c31\u6253\u6bd4\u65b9\u8bf4\uff0c\u4f20\u7edf\u7a0b\u5e8f\u662f\u4eba\u5199\u89c4\u5219\u5582\u8fdb\u53bb\u8f93\u51fa\u7ed3\u679c\uff0c\u673a\u5668\u5b66\u4e60\u53cd\u8fc7\u6765\uff0c\u4f60\u628a\u6570\u636e\u548c\u5bf9\u5e94\u7684\u7ed3\u679c\u5582\u8fdb\u53bb\uff0c\u5b83\u81ea\u5df1\u7ed9\u4f60\u63d0\u70bc\u51fa\u89c4\u5219\u6765\u3002\u90a3\u54b1\u4eec\u5165\u95e8\u6700\u5148\u63a5\u89e6\u7684\u80af\u5b9a\u5c31\u662f\u76d1\u7763\u5b66\u4e60\u5bf9\u5427\uff0c\u5b83\u7684\u6807\u51c6\u6d41\u7a0b\u662f\u4e0d\u662f\u4e5f\u6709\u56fa\u5b9a\u7684\u6b65\u9aa4\uff1f"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u5b8c\u5168\u6ca1\u9519\uff0c\u6807\u51c6\u76d1\u7763\u5b66\u4e60\u8d70\u4e0b\u6765\u6b63\u597d\u662f\u4e94\u6b65\uff1a\u7b2c\u4e00\u6b65\u5148\u628a\u624b\u4e0a\u7684\u6570\u636e\u96c6\u968f\u673a\u5212\u6210\u8bad\u7ec3\u96c6\u3001\u9a8c\u8bc1\u96c6\u3001\u6d4b\u8bd5\u96c6\u4e09\u4efd\uff0c\u5404\u53f8\u5176\u804c\u7edd\u5bf9\u4e0d\u80fd\u6df7\u7528\uff1b\u7b2c\u4e8c\u6b65\u9009\u9002\u914d\u4efb\u52a1\u7684\u6a21\u578b\uff0c\u6bd4\u5982\u7ebf\u6027\u56de\u5f52\u3001\u903b\u8f91\u56de\u5f52\u3001\u51b3\u7b56\u6811\u3001\u652f\u6301\u5411\u91cf\u673a\u3001\u795e\u7ecf\u7f51\u7edc\u8fd9\u4e9b\u90fd\u5728\u53ef\u9009\u8303\u56f4\u5185\uff1b\u7b2c\u4e09\u6b65\u5b9a\u4e49\u635f\u5931\u51fd\u6570\uff0c\u4e13\u95e8\u8861\u91cf\u9884\u6d4b\u7ed3\u679c\u548c\u771f\u5b9e\u6807\u7b7e\u7684\u5dee\u8ddd\uff0c\u505a\u56de\u5f52\u4efb\u52a1\u5e38\u7528\u5747\u65b9\u8bef\u5dee\uff0c\u505a\u5206\u7c7b\u4efb\u52a1\u5c31\u7528\u4ea4\u53c9\u71b5\uff1b\u7b2c\u56db\u6b65\u7528\u68af\u5ea6\u4e0b\u964d\u8fd9\u7c7b\u4f18\u5316\u7b97\u6cd5\u4e0d\u65ad\u8fed\u4ee3\u6700\u5c0f\u5316\u635f\u5931\uff1b\u6700\u540e\u4e00\u6b65\u624d\u62ff\u51fa\u4ece\u6765\u6ca1\u78b0\u8fc7\u7684\u6d4b\u8bd5\u96c6\u8bc4\u4f30\u6700\u7ec8\u6548\u679c\u3002"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u54ce\u8bf4\u5230\u8bc4\u4f30\u6211\u5c31\u60f3\u8d77\u521a\u5165\u884c\u7684\u8bef\u533a\uff0c\u6211\u5f53\u521d\u4ee5\u4e3a\u628a\u8bad\u7ec3\u96c6\u7684\u6b63\u786e\u7387\u5237\u5230100%\u5c31\u662f\u6a21\u578b\u5389\u5bb3\uff0c\u7ed3\u679c\u8dd1\u6d4b\u8bd5\u96c6\u76f4\u63a5\u7ffb\u8f66\uff0c\u8fd9\u662f\u4e0d\u662f\u5927\u5bb6\u5e38\u8bf4\u7684\u8fc7\u62df\u5408\u554a\uff1f"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u8fd9\u7edd\u5bf9\u662f90%\u7684\u65b0\u624b\u90fd\u4f1a\u8e29\u7684\u8ba4\u77e5\u5751\uff0c\u6211\u5fc5\u987b\u7ed9\u5927\u5bb6\u6572\u4e2a\u8b66\u949f\uff1a\u673a\u5668\u5b66\u4e60\u7684\u7ec8\u6781\u76ee\u6807\u6839\u672c\u4e0d\u662f\u5728\u8bad\u7ec3\u96c6\u4e0a\u8003\u6ee1\u5206\uff0c\u800c\u662f\u300c\u6cdb\u5316\u300d\u2014\u2014\u5c31\u662f\u5728\u5168\u65b0\u7684\u672a\u89c1\u6570\u636e\u4e0a\u8868\u73b0\u597d\u3002\u5982\u679c\u4f60\u6a21\u578b\u9009\u7684\u592a\u7b80\u5355\uff0c\u6bd4\u5982\u7528\u4e00\u6761\u76f4\u7ebf\u53bb\u62df\u5408\u672c\u6765\u662f\u66f2\u7ebf\u5206\u5e03\u7684\u6570\u636e\uff0c\u6700\u540e\u8bad\u7ec3\u96c6\u548c\u6d4b\u8bd5\u96c6\u6548\u679c\u90fd\u60e8\u4e0d\u5fcd\u7779\uff0c\u8fd9\u5c31\u662f\u6b20\u62df\u5408\uff0c\u5bf9\u5e94\u7684\u662f\u9ad8\u504f\u5dee\u3002\u53cd\u8fc7\u6765\u4f60\u628a\u6a21\u578b\u505a\u7684\u7279\u522b\u590d\u6742\uff0c\u5b83\u4e0d\u5149\u5b66\u89c4\u5f8b\uff0c\u8fde\u8bad\u7ec3\u96c6\u91cc\u7684\u968f\u673a\u566a\u58f0\u90fd\u5168\u80cc\u4e0b\u6765\u4e86\uff0c\u8bad\u7ec3\u96c6\u6b63\u786e\u7387\u63a5\u8fd1\u6ee1\u5206\uff0c\u4e00\u4e0a\u6d4b\u8bd5\u96c6\u76f4\u63a5\u57ae\u6389\uff0c\u8fd9\u5c31\u662f\u8fc7\u62df\u5408\uff0c\u5bf9\u5e94\u7684\u662f\u9ad8\u65b9\u5dee\u3002"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u4e4b\u524d\u4e00\u76f4\u542c\u4eba\u8bf4\u504f\u5dee\u65b9\u5dee\u6743\u8861\u662f\u6240\u6709\u6a21\u578b\u9009\u62e9\u7684\u5e95\u5c42\u903b\u8f91\uff0c\u4f60\u80fd\u4e0d\u80fd\u7ed9\u6211\u4eec\u62c6\u89e3\u4e0b\u8fd9\u4e2a\u539f\u7406\u5230\u5e95\u662f\u4ec0\u4e48\u610f\u601d\uff1f"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u5176\u5b9e\u7279\u522b\u597d\u7406\u89e3\uff0c\u6211\u4eec\u6700\u7ec8\u6d4b\u51fa\u6765\u7684\u6cdb\u5316\u8bef\u5dee\u53ef\u4ee5\u76f4\u63a5\u62c6\u6210\u4e09\u90e8\u5206\uff1a\u504f\u5dee\u7684\u5e73\u65b9\u52a0\u4e0a\u65b9\u5dee\uff0c\u518d\u52a0\u4e0a\u4e00\u4e2a\u5b8c\u5168\u6ca1\u529e\u6cd5\u6d88\u9664\u7684\u4e0d\u53ef\u7ea6\u8bef\u5dee\uff0c\u4e5f\u5c31\u662f\u6570\u636e\u672c\u8eab\u81ea\u5e26\u7684\u5929\u7136\u566a\u58f0\u3002\u5176\u4e2d\u504f\u5dee\u4ee3\u8868\u6211\u4eec\u9009\u7684\u6a21\u578b\u5047\u8bbe\u548c\u771f\u5b9e\u4e16\u754c\u89c4\u5f8b\u4e4b\u95f4\u7684\u7cfb\u7edf\u6027\u5dee\u8ddd\uff0c\u65b9\u5dee\u4ee3\u8868\u6a21\u578b\u5bf9\u8bad\u7ec3\u6570\u636e\u7684\u5fae\u5c0f\u6270\u52a8\u6709\u591a\u654f\u611f\u3002\u4f60\u53ea\u8981\u63d0\u5347\u6a21\u578b\u590d\u6742\u5ea6\uff0c\u901a\u5e38\u504f\u5dee\u4f1a\u4e0d\u65ad\u4e0b\u964d\uff0c\u4f46\u65b9\u5dee\u4f1a\u8ddf\u7740\u5f80\u4e0a\u6da8\uff0c\u6548\u679c\u6700\u597d\u7684\u6a21\u578b\u4e00\u5b9a\u662f\u5728\u4e24\u8005\u4e4b\u95f4\u627e\u5230\u4e86\u6700\u4f18\u7684\u5e73\u8861\u70b9\uff0c\u8fd9\u4e2a\u6846\u67b6\u53ef\u4ee5\u89e3\u91ca\u51e0\u4e4e\u6240\u6709\u6a21\u578b\u8c03\u4f18\u7684\u51b3\u7b56\u903b\u8f91\u3002"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u90a3\u6211\u4eec\u5e73\u65f6\u9879\u76ee\u91cc\u7528\u7684\u5404\u79cd\u5bf9\u6297\u8fc7\u62df\u5408\u7684\u624b\u6bb5\uff0c\u672c\u8d28\u90fd\u662f\u5728\u8c03\u6574\u8fd9\u4e2a\u504f\u5dee\u65b9\u5dee\u7684\u5e73\u8861\u5bf9\u5427\uff1f\u6211\u5370\u8c61\u91cc\u6700\u76f4\u63a5\u7684\u80af\u5b9a\u662f\u6512\u66f4\u591a\u6807\u6ce8\u6570\u636e\uff0c\u4e0d\u8fc7\u8fd9\u4e2a\u6210\u672c\u5b9e\u5728\u592a\u9ad8\u4e86\u3002"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u6ca1\u9519\uff0c\u9664\u6b64\u4e4b\u5916\u8fd8\u6709\u597d\u51e0\u7c7b\u6807\u51c6\u6b66\u5668\uff1a\u6bd4\u5982\u6b63\u5219\u5316\uff0cL1\u6b63\u5219\u4f1a\u903c\u5f88\u591a\u6a21\u578b\u6743\u91cd\u53d8\u62100\uff0c\u81ea\u52a8\u5e2e\u4f60\u505a\u7279\u5f81\u9009\u62e9\uff0cL2\u6b63\u5219\u4e5f\u53eb\u6743\u91cd\u8870\u51cf\uff0c\u76f4\u63a5\u60e9\u7f5a\u6570\u503c\u8fc7\u5927\u7684\u6743\u91cd\uff0c\u907f\u514d\u6a21\u578b\u88ab\u4e2a\u522b\u5f02\u5e38\u7279\u5f81\u5e26\u504f\uff1b\u8fd8\u6709k\u6298\u4ea4\u53c9\u9a8c\u8bc1\uff0c\u80fd\u66f4\u53ef\u9760\u5730\u4f30\u8ba1\u6cdb\u5316\u6027\u80fd\u3001\u8c03\u8d85\u53c2\u6570\uff1b\u8bad\u7ec3\u5230\u9a8c\u8bc1\u96c6\u8bef\u5dee\u4e0d\u518d\u4e0b\u964d\u5c31\u63d0\u524d\u7ec8\u6b62\u7684\u65e9\u505c\u6cd5\uff0c\u6df1\u5ea6\u5b66\u4e60\u91cc\u5e38\u7528\u7684Dropout\u3001\u6570\u636e\u589e\u5f3a\uff0c\u8fd9\u4e9b\u5168\u90fd\u662f\u5de5\u4e1a\u754c\u666e\u904d\u5728\u7528\u7684\u5bf9\u6297\u8fc7\u62df\u5408\u65b9\u6848\u3002"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u8bf4\u5230\u8fd9\u6211\u5fc5\u987b\u5206\u4eab\u6211\u5f53\u5e74\u8e29\u7684\u8bc4\u4f30\u6307\u6807\u5927\u5751\uff0c\u6211\u65e9\u5e74\u505a\u8fc7\u4e00\u4e2a\u764c\u75c7\u7b5b\u67e5\u7684AI\u9879\u76ee\uff0c\u6570\u636e\u96c6\u91cc\u4e00\u4e07\u4e2a\u4eba\u91cc\u53ea\u670910\u4e2a\u662f\u771f\u60a3\u764c\u7684\uff0c\u6211\u5f53\u65f6\u5077\u61d2\u5199\u4e86\u4e2a\u57fa\u7ebf\u6a21\u578b\u5565\u90fd\u4e0d\u5b66\uff0c\u76f4\u63a5\u5168\u8f93\u51fa\u300c\u5065\u5eb7\u300d\uff0c\u51c6\u786e\u7387\u5c45\u7136\u5c31\u670999.9%\uff0c\u6211\u5f53\u65f6\u8fd8\u50bb\u4e50\u4ee5\u4e3a\u6a21\u578b\u6548\u679c\u7206\u70b8\uff0c\u7ed3\u679c\u4e00\u4e0a\u7ebf\u6839\u672c\u6ca1\u6cd5\u7528\uff01\u540e\u6765\u624d\u660e\u767d\u7c7b\u522b\u4e0d\u5e73\u8861\u573a\u666f\u4e0b\u51c6\u786e\u7387\u5b8c\u5168\u662f\u9a97\u4eba\u7684\uff0c\u6839\u672c\u4e0d\u80fd\u5355\u770b\u8fd9\u4e00\u4e2a\u6307\u6807\u3002\u4f60\u6bd4\u5982\u764c\u75c7\u7b5b\u67e5\u573a\u666f\uff0c\u6211\u4eec\u5b81\u53ef\u591a\u62a5\u51e0\u4e2a\u7591\u4f3c\u75c5\u4f8b\u8ba9\u7528\u6237\u590d\u68c0\uff0c\u4e5f\u7edd\u5bf9\u4e0d\u80fd\u6f0f\u8fc7\u4e00\u4e2a\u771f\u60a3\u764c\u7684\uff0c\u8fd9\u65f6\u5019\u80af\u5b9a\u4f18\u5148\u770b\u53ec\u56de\u7387\u3002\u8981\u662f\u4f60\u505a\u7535\u5546\u5546\u54c1\u63a8\u8350\uff0c\u603b\u4e0d\u80fd\u4e71\u63a8\u4e00\u5806\u7528\u6237\u5b8c\u5168\u4e0d\u611f\u5174\u8da3\u7684\u5185\u5bb9\u9a9a\u6270\u4eba\u5427\uff0c\u8fd9\u65f6\u5019\u53cd\u800c\u66f4\u770b\u91cd\u7cbe\u786e\u7387\uff0c\u6240\u6709\u6307\u6807\u9009\u62e9\u90fd\u5f97\u7d27\u6263\u4e1a\u52a1\u76ee\u6807\uff0c\u8fd9\u4e2a\u6559\u8bad\u6211\u5230\u73b0\u5728\u90fd\u8bb0\u5f97\u6e05\u6e05\u695a\u695a\u3002"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u804a\u5b8c\u8bc4\u4f30\u903b\u8f91\uff0c\u54b1\u4eec\u5f80\u4e0b\u624e\u4e00\u5c42\uff0c\u5f88\u591a\u4eba\u521a\u63a5\u89e6\u6df1\u5ea6\u5b66\u4e60\u7684\u65f6\u5019\u90fd\u89c9\u5f97\u795e\u7ecf\u7f51\u7edc\u8bad\u7ec3\u662f\u4e2a\u9ed1\u7bb1\uff0c\u597d\u50cf\u5b83\u83ab\u540d\u5176\u5999\u81ea\u5df1\u5c31\u5b66\u4f1a\u4e86\uff0c\u5176\u5b9e\u6574\u4e2a\u8fc7\u7a0b\u6700\u6838\u5fc3\u7684\u5c31\u4e24\u4e2a\u6734\u7d20\u5de5\u5177\uff1a\u68af\u5ea6\u4e0b\u964d\u8d1f\u8d23\u641e\u6e05\u695a\u300c\u5f80\u54ea\u4e2a\u65b9\u5411\u8d70\u80fd\u6700\u5feb\u964d\u4f4e\u8bef\u5dee\u300d\uff0c\u53cd\u5411\u4f20\u64ad\u8d1f\u8d23\u9ad8\u6548\u7b97\u51fa\u8fd9\u4e2a\u65b9\u5411\u7684\u5177\u4f53\u6570\u503c\uff0c\u4e00\u70b9\u90fd\u4e0d\u795e\u79d8\u3002"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u592a\u5bf9\u4e86\uff01\u6211\u521a\u5b66\u7684\u65f6\u5019\u8fd8\u4ee5\u4e3a\u795e\u7ecf\u7f51\u7edc\u7684\u5b66\u4e60\u662f\u4ec0\u4e48\u79d1\u5e7b\u7247\u91cc\u7684\u4eba\u5de5\u667a\u80fd\u9b54\u6cd5\uff0c\u7b49\u641e\u61c2\u539f\u7406\u5dee\u70b9\u7b11\u51fa\u6765\uff0c\u539f\u6765\u6838\u5fc3\u903b\u8f91\u5c31\u662f\u4e2a\u300c\u5728\u5c71\u4e0a\u627e\u8c37\u5e95\u300d\u7684\u8fc7\u7a0b\u5bf9\u5427\uff1f"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u4f60\u8fd9\u4e2a\u7c7b\u6bd4\u5b8c\u5168\u7cbe\u51c6\u3002\u6211\u4eec\u53ef\u4ee5\u628a\u635f\u5931\u51fd\u6570\u60f3\u8c61\u6210\u4e00\u7247\u8fde\u7ef5\u8d77\u4f0f\u7684\u5c71\u5730\uff0c\u5c71\u5730\u91cc\u6bcf\u4e00\u4e2a\u70b9\u7684\u5750\u6807\u5bf9\u5e94\u7684\u5c31\u662f\u795e\u7ecf\u7f51\u7edc\u7684\u6240\u6709\u6743\u91cd\u548c\u504f\u7f6e\u53c2\u6570\uff0c\u6211\u4eec\u8bad\u7ec3\u7684\u7ec8\u6781\u76ee\u6807\uff0c\u5c31\u662f\u8d70\u5230\u8fd9\u7247\u5c71\u7684\u6700\u4f4e\u70b9\uff0c\u4e5f\u5c31\u662f\u635f\u5931\u503c\u6700\u5c0f\u7684\u4f4d\u7f6e\u3002"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u90a3\u68af\u5ea6\u8fd9\u4e2a\u4e1c\u897f\u5728\u8fd9\u91cc\u662f\u8d77\u4ec0\u4e48\u4f5c\u7528\u7684\uff1f\u6211\u8bb0\u5f97\u5927\u5b66\u5fae\u79ef\u5206\u8bfe\u5c31\u5b66\u8fc7\u68af\u5ea6\uff0c\u4f46\u662f\u4ece\u6765\u6ca1\u628a\u5b83\u548c\u673a\u5668\u5b66\u4e60\u8bad\u7ec3\u7684\u573a\u666f\u8054\u7cfb\u8d77\u6765\uff0c\u603b\u89c9\u5f97\u662f\u4e2a\u5f88\u62bd\u8c61\u7684\u6570\u5b66\u6982\u5ff5\u3002"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u68af\u5ea6\u672c\u8eab\u6307\u5411\u7684\u662f\u51fd\u6570\u503c\u4e0a\u5347\u901f\u5ea6\u6700\u5feb\u7684\u65b9\u5411\uff0c\u90a3\u6211\u4eec\u5f80\u5b83\u7684\u53cd\u65b9\u5411\u8d70\uff0c\u81ea\u7136\u5c31\u662f\u4e0b\u964d\u6700\u5feb\u7684\u8def\u5f84\u3002\u68af\u5ea6\u4e0b\u964d\u7684\u66f4\u65b0\u89c4\u5219\u5199\u51fa\u6765\u5c31\u4e00\u884c\u516c\u5f0f\uff1a\u7528\u5f53\u524d\u7684\u53c2\u6570\u51cf\u53bb\u5b66\u4e60\u7387\u4e58\u4ee5\u68af\u5ea6\uff0c\u5c31\u5b8c\u6210\u4e86\u4e00\u6b65\u4f4d\u7f6e\u79fb\u52a8\uff0c\u903b\u8f91\u7279\u522b\u76f4\u767d\u3002"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u54e6\u5bf9\uff0c\u8fd9\u91cc\u9762\u8fd8\u6709\u4e2a\u53eb\u5b66\u4e60\u7387\u7684\u8d85\u53c2\u6570\u5bf9\u5427\uff1f\u6211\u4e4b\u524d\u8c03\u53c2\u7684\u65f6\u5019\u5728\u5b83\u8eab\u4e0a\u8e29\u8fc7\u5de8\u591a\u5751\uff0c\u5b66\u4e60\u7387\u8bbe\u4e0d\u5bf9\u8bad\u7ec3\u76f4\u63a5\u5c31\u5d29\u4e86\uff0c\u4f60\u80fd\u4e0d\u80fd\u597d\u597d\u8bb2\u8bb2\uff0c\u4e3a\u4ec0\u4e48\u4e1a\u5185\u90fd\u8bf4\u5b66\u4e60\u7387\u662f\u6700\u5173\u952e\u7684\u8d85\u53c2\u6570\uff1f"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u5b8c\u5168\u6ca1\u9519\uff0c\u5b66\u4e60\u7387\u672c\u8d28\u5c31\u662f\u63a7\u5236\u4f60\u6bcf\u4e00\u6b65\u4e0b\u5c71\u8fc8\u591a\u5927\u6b65\u5b50\u3002\u4f60\u8981\u662f\u6b65\u5b50\u8fc8\u592a\u5927\uff0c\u5f88\u53ef\u80fd\u76f4\u63a5\u4e00\u6b65\u8de8\u8fc7\u5934\uff0c\u5728\u5c71\u8c37\u4e24\u8fb9\u6765\u56de\u6a2a\u8df3\uff0c\u751a\u81f3\u76f4\u63a5\u8d8a\u8d70\u8d8a\u9ad8\u5f80\u5c71\u9876\u53bb\uff0c\u6574\u4e2a\u8bad\u7ec3\u76f4\u63a5\u53d1\u6563\u635f\u5931\u98d9\u4e0a\u5929\uff1b\u4f46\u4f60\u8981\u662f\u6b65\u5b50\u592a\u5c0f\uff0c\u8d70\u5f97\u6162\u4e0d\u8bf4\uff0c\u8017\u4e0a\u51e0\u5341\u4e2a\u5c0f\u65f6\u90fd\u6478\u4e0d\u5230\u8c37\u5e95\uff0c\u6536\u655b\u901f\u5ea6\u6162\u5230\u5b8c\u5168\u6ca1\u6cd5\u7528\u3002"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u539f\u6765\u5982\u6b64\uff0c\u6211\u4e4b\u524d\u8bd5\u8fc7\u4e0d\u540c\u7684\u68af\u5ea6\u4e0b\u964d\u5b9e\u73b0\uff0c\u597d\u50cf\u4e0d\u540c\u7684\u91c7\u6837\u65b9\u5f0f\u6548\u679c\u5dee\u7279\u522b\u591a\uff0c\u4ec0\u4e48\u6279\u91cf\u7684\u3001\u968f\u673a\u7684\uff0c\u8fd9\u91cc\u9762\u7684\u5b9e\u9645\u533a\u522b\u5230\u5e95\u5728\u54ea\uff1f"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u5bf9\uff0c\u4e1a\u5185\u6839\u636e\u4f60\u6bcf\u6b21\u7b97\u68af\u5ea6\u7528\u591a\u5c11\u6570\u636e\uff0c\u5206\u6210\u4e86\u4e09\u7c7b\u4e3b\u6d41\u65b9\u6848\uff1a\u7b2c\u4e00\u79cd\u662f\u6279\u91cf\u68af\u5ea6\u4e0b\u964d\uff0c\u628a\u5168\u91cf\u6570\u636e\u96c6\u90fd\u8fc7\u4e00\u904d\u518d\u7b97\u68af\u5ea6\uff0c\u68af\u5ea6\u7b97\u5f97\u7279\u522b\u51c6\uff0c\u4f46\u662f\u6570\u636e\u91cf\u5927\u4e86\u4e4b\u540e\u4e0d\u4ec5\u901f\u5ea6\u6162\uff0c\u5185\u5b58\u90fd\u88c5\u4e0d\u4e0b\u5168\u91cf\u6570\u636e\uff0c\u6839\u672c\u6ca1\u6cd5\u5728\u5927\u9879\u76ee\u91cc\u7528\u3002\u7b2c\u4e8c\u79cd\u662f\u968f\u673a\u68af\u5ea6\u4e0b\u964d\uff0c\u6bcf\u6b21\u53ea\u62ff\u4e00\u4e2a\u6837\u672c\u7b97\u68af\u5ea6\uff0c\u901f\u5ea6\u98de\u5feb\uff0c\u4f46\u7f3a\u70b9\u662f\u68af\u5ea6\u7684\u566a\u58f0\u7279\u522b\u5927\uff0c\u4e0b\u5c71\u7684\u65f6\u5019\u8d70\u5f97\u6b6a\u6b6a\u626d\u626d\uff0c\u9707\u8361\u7279\u522b\u5389\u5bb3\u3002"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u90a3\u80af\u5b9a\u6ca1\u4eba\u6b7b\u78d5\u8fd9\u4e24\u4e2a\u6781\u7aef\u65b9\u6848\u554a\uff0c\u6211\u73b0\u5728\u6240\u6709\u9879\u76ee\u91cc\u7528\u7684\u5168\u90fd\u662f\u5c0f\u6279\u91cf\u68af\u5ea6\u4e0b\u964d\u5bf9\u5427\uff1f\u6bcf\u6b21\u62bd\u4e2a32\u300164\u4e2a\u5c0f\u6279\u6b21\u6837\u672c\u7b97\u68af\u5ea6\uff0c\u51fa\u6765\u7684\u6548\u679c\u53c8\u7a33\u53c8\u5feb\u3002"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u6ca1\u9519\uff0c\u8fd9\u4e2a\u5c0f\u6279\u91cf\u662f\u73b0\u5728\u5de5\u4e1a\u754c\u7684\u6807\u51c6\u6298\u4e2d\u65b9\u6848\uff0c\u4e00\u65b9\u9762\u80fd\u5b8c\u7f8e\u5229\u7528GPU\u7684\u5e76\u884c\u8ba1\u7b97\u80fd\u529b\uff0c\u8dd1\u8d77\u6765\u901f\u5ea6\u5feb\u5f88\u591a\uff0c\u53e6\u4e00\u65b9\u9762\u9002\u5ea6\u7684\u68af\u5ea6\u566a\u58f0\u8fd8\u80fd\u5e2e\u4f60\u8df3\u51fa\u90a3\u4e9b\u4e0d\u592a\u597d\u7684\u5c40\u90e8\u5c0f\u5751\uff0c\u53cd\u800c\u6700\u7ec8\u7684\u6cdb\u5316\u6548\u679c\u66f4\u597d\u3002"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u6211\u4e4b\u524d\u7b2c\u4e00\u6b21\u4e0a\u624b\u5199\u6df1\u5ea6\u7f51\u7edc\u7684\u65f6\u5019\u61f5\u4e86\uff0c\u4e00\u4e2a\u5927\u6a21\u578b\u52a8\u8f84\u51e0\u767e\u4e07\u4e0a\u5343\u4e07\u4e2a\u53c2\u6570\uff0c\u8981\u662f\u6328\u4e2a\u624b\u52a8\u7b97\u68af\u5ea6\u5f97\u7b97\u5230\u7334\u5e74\u9a6c\u6708\u53bb\uff0c\u8fd9\u4e2a\u53cd\u5411\u4f20\u64ad\u5230\u5e95\u662f\u600e\u4e48\u628a\u8fd9\u4e2a\u8ba1\u7b97\u6548\u7387\u63d0\u4e0a\u6765\u7684\uff1f"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u53cd\u5411\u4f20\u64ad\u8bf4\u7a7f\u4e86\u4e00\u70b9\u90fd\u4e0d\u9ad8\u6df1\uff0c\u672c\u8d28\u5c31\u662f\u5fae\u79ef\u5206\u91cc\u7684\u94fe\u5f0f\u6cd5\u5219\uff0c\u518d\u52a0\u4e0a\u52a8\u6001\u89c4\u5212\u7684\u590d\u7528\u601d\u8def\u3002\u6211\u4eec\u5148\u505a\u524d\u5411\u4f20\u64ad\uff0c\u628a\u8f93\u5165\u4ece\u7b2c\u4e00\u5c42\u9010\u5c42\u7b97\u5230\u6700\u540e\u4e00\u5c42\uff0c\u5f97\u5230\u9884\u6d4b\u7ed3\u679c\u548c\u635f\u5931\u503c\u3002\u7136\u540e\u53cd\u5411\u4ece\u635f\u5931\u8fd9\u5934\u5f80\u56de\u8d70\uff0c\u9010\u5c42\u7528\u94fe\u5f0f\u6cd5\u5219\u7b97\u6bcf\u4e2a\u53c2\u6570\u7684\u68af\u5ea6\uff0c\u540e\u9762\u4e00\u5c42\u5df2\u7ecf\u7b97\u51fa\u6765\u7684\u68af\u5ea6\u53ef\u4ee5\u76f4\u63a5\u7ed9\u524d\u4e00\u5c42\u590d\u7528\uff0c\u76f4\u63a5\u628a\u539f\u672c\u6307\u6570\u7ea7\u7684\u8ba1\u7b97\u590d\u6742\u5ea6\uff0c\u964d\u5230\u4e86\u548c\u524d\u5411\u4f20\u64ad\u540c\u4e00\u4e2a\u91cf\u7ea7\uff0c\u6548\u7387\u4e00\u4e0b\u5c31\u4e0a\u6765\u4e86\u3002"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u6211\u4e4b\u524d\u521a\u5165\u95e8\u7684\u65f6\u5019\u4e3a\u4e86\u641e\u61c2\u8fd9\u4e2a\uff0c\u8fd8\u81ea\u5df1\u624b\u63a8\u8fc7\u4e09\u5c42\u5168\u8fde\u63a5\u7f51\u7edc\u7684\u53cd\u5411\u4f20\u64ad\u516c\u5f0f\uff0c\u63a8\u5b8c\u77ac\u95f4\u5c31\u901a\u4e86\u2014\u2014\u8bf4\u767d\u4e86\u5b83\u5c31\u662f\u5728\u6328\u4e2a\u56de\u7b54\u4e00\u4e2a\u95ee\u9898\uff1a\u5f53\u524d\u8fd9\u4e2a\u6743\u91cd\uff0c\u5bf9\u6700\u7ec8\u7684\u603b\u8bef\u5dee\u5230\u5e95\u8d21\u732e\u4e86\u591a\u5c11\uff0c\u8d21\u732e\u5927\u7684\u5c31\u591a\u8c03\u6574\u70b9\uff0c\u8d21\u732e\u5c0f\u7684\u5c31\u5c11\u52a8\u4e24\u4e0b\uff0c\u903b\u8f91\u7279\u522b\u6734\u7d20\u3002\u6211\u5f53\u521d\u8fd8\u81ea\u5df1\u624b\u5199\u8fc7\u4e00\u7248\u6734\u7d20SGD\u7684\u4f18\u5316\u5668\uff0c\u8e29\u8fc7\u597d\u591a\u5751\uff0c\u540e\u6765\u987a\u7740\u6f14\u8fdb\u8def\u7ebf\u4e00\u8def\u6478\u4e0b\u6765\u624d\u77e5\u9053\u5927\u5bb6\u4e3a\u5565\u73b0\u5728\u90fd\u9ed8\u8ba4\u7528Adam\u3002"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u54e6\uff1f\u4f60\u8fd8\u624b\u5199\u8fc7\u4f18\u5316\u5668\u90a3\u80af\u5b9a\u5bf9\u8fd9\u4e2a\u6f14\u8fdb\u8def\u5f84\u7406\u89e3\u7279\u522b\u6df1\uff0c\u7ed9\u6211\u4eec\u5927\u5bb6\u8bb2\u8bb2\u80cc\u540e\u7684\u601d\u8def\u5457\uff1f"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u6700\u5f00\u59cb\u7684\u6734\u7d20SGD\u7f3a\u70b9\u7279\u522b\u660e\u663e\uff0c\u4e0b\u5c71\u7ecf\u5e38\u5361\u5230\u5c40\u90e8\u5c0f\u5751\u91cc\u534a\u5929\u8d70\u4e0d\u52a8\uff0c\u540e\u6765\u5927\u5bb6\u7ed9\u5b83\u52a0\u4e86\u52a8\u91cf\u673a\u5236\uff0c\u7d2f\u79ef\u4e4b\u524d\u5386\u53f2\u7684\u68af\u5ea6\uff0c\u5c31\u50cf\u4e2a\u6eda\u4e0b\u5c71\u7684\u5c0f\u7403\u5e26\u60ef\u6027\uff0c\u80fd\u76f4\u63a5\u51b2\u8fc7\u5c0f\u5751\uff0c\u6536\u655b\u901f\u5ea6\u5feb\u5f88\u591a\u3002\u4e4b\u540e\u53c8\u51fa\u4e86AdaGrad\u3001RMSProp\u8fd9\u7c7b\u81ea\u9002\u5e94\u5b66\u4e60\u7387\u7684\u65b9\u6848\uff0c\u7ed9\u4e0d\u540c\u53c2\u6570\u914d\u4e0d\u540c\u7684\u5b66\u4e60\u7387\uff0c\u66f4\u65b0\u9891\u7387\u9ad8\u7684\u53c2\u6570\u81ea\u52a8\u51cf\u5c0f\u6b65\u957f\uff0c\u4e0d\u7528\u4eba\u624b\u52a8\u7ed9\u6240\u6709\u53c2\u6570\u7edf\u4e00\u8c03\u6b65\u957f\u4e86\u3002\u6700\u540eAdam\u628a\u52a8\u91cf\u548c\u81ea\u9002\u5e94\u5b66\u4e60\u7387\u4e24\u4e2a\u4f18\u70b9\u7ed3\u5408\u8d77\u6765\uff0c\u73b0\u5728\u57fa\u672c\u662f\u5927\u5bb6\u4e0a\u624b\u9ed8\u8ba4\u7684\u4f18\u5316\u5668\uff0c\u9664\u975e\u6709\u7279\u6b8a\u9700\u6c42\u624d\u4f1a\u6362\u522b\u7684\u3002"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u54ce\u8bf4\u5230\u8fd9\u6211\u60f3\u8d77\u597d\u591a\u65b0\u624b\u90fd\u4f1a\u95ee\u7684\u4e00\u4e2a\u7ecf\u5178\u95ee\u9898\uff0c\u65e2\u7136\u6df1\u5ea6\u795e\u7ecf\u7f51\u7edc\u7684\u635f\u5931\u66f2\u9762\u662f\u4e2a\u975e\u51f8\u7684\uff0c\u7406\u8bba\u4e0a\u6709\u65e0\u6570\u4e2a\u5c40\u90e8\u6700\u4f4e\u70b9\uff0c\u6309\u9053\u7406\u5f88\u5bb9\u6613\u5361\u5728\u5f88\u5dee\u7684\u5c40\u90e8\u6700\u4f18\u51fa\u4e0d\u6765\uff0c\u4e3a\u4ec0\u4e48\u73b0\u5b9e\u91cc\u6df1\u5ea6\u5b66\u4e60\u8bad\u7ec3\u51fa\u6765\u7684\u6548\u679c\u8fd8\u90fd\u8fd9\u4e48\u597d\uff1f"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u6211\u4e4b\u524d\u4e13\u95e8\u67e5\u8fc7\u76f8\u5173\u7684\u7814\u7a76\uff0c\u9ad8\u7ef4\u53c2\u6570\u7a7a\u95f4\u91cc\uff0c\u5927\u90e8\u5206\u7684\u4e34\u754c\u70b9\u6839\u672c\u4e0d\u662f\u7cdf\u7cd5\u7684\u5c40\u90e8\u6700\u4f18\uff0c\u53cd\u800c\u662f\u978d\u70b9\uff0c\u5361\u5728\u90a3\u91cc\u68af\u5ea6\u51e0\u4e4e\u4e3a\u96f6\u8d70\u4e0d\u52a8\uff0c\u4f46\u73b0\u5728\u6211\u4eec\u7528\u7684\u5e26\u566a\u58f0\u7684\u5c0f\u6279\u91cf\u68af\u5ea6\u4e0b\u964d\uff0c\u8fd8\u6709\u5404\u79cd\u6210\u719f\u7684\u521d\u59cb\u5316\u3001\u6279\u5f52\u4e00\u5316\u3001\u6b8b\u5dee\u8fde\u63a5\u8fd9\u4e9b\u6280\u5de7\uff0c\u5f88\u5bb9\u6613\u5c31\u80fd\u4ece\u978d\u70b9\u4e0a\u6ed1\u8fc7\u53bb\uff0c\u6700\u540e\u627e\u5230\u7684\u5927\u90e8\u5206\u5c40\u90e8\u6700\u4f18\u89e3\u8d28\u91cf\u90fd\u7279\u522b\u597d\uff0c\u5b8c\u5168\u80fd\u6ee1\u8db3\u4e1a\u52a1\u9700\u6c42\uff0c\u8fd9\u5176\u5b9e\u5c31\u662f\u6574\u4e2a\u6df1\u5ea6\u5b66\u4e60\u9769\u547d\u80fd\u6210\u7acb\u7684\u6570\u5b66\u5e95\u5ea7\u554a\u3002"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u8bb2\u5b8c\u4e86\u4f18\u5316\u7684\u5e95\u5c42\u539f\u7406\uff0c\u6211\u4eec\u63a5\u4e0b\u6765\u5c31\u987a\u7740\u65f6\u95f4\u7ebf\u68b3\u7406\u4e00\u4e0b\u795e\u7ecf\u7f51\u7edc\u67b6\u6784\u7684\u6574\u4e2a\u6f14\u8fdb\u8109\u7edc\uff0c\u4f60\u4f1a\u53d1\u73b0\u6bcf\u4e00\u4ee3\u65b0\u67b6\u6784\u7684\u8bde\u751f\uff0c\u90fd\u662f\u7cbe\u51c6\u8865\u4e0a\u4e86\u524d\u4e00\u4ee3\u89e3\u51b3\u4e0d\u4e86\u7684\u786c\u4f24\uff0c\u5b8c\u5168\u4e0d\u662f\u79d1\u7814\u4eba\u5458\u62cd\u8111\u888b\u60f3\u51fa\u6765\u7684\u70ab\u6280\u8bbe\u8ba1\u3002"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u8fd9\u4e2a\u6211\u592a\u6709\u611f\u89e6\u4e86\uff0c\u6211\u521a\u5165\u95e8\u6df1\u5ea6\u5b66\u4e60\u7684\u65f6\u5019\uff0c\u6700\u5f00\u59cb\u5b66\u7684\u5c31\u662f\u5168\u8fde\u63a5\u7f51\u7edc\uff0c\u5f53\u65f6\u89c9\u5f97\u8fd9\u4e2a\u7ed3\u6784\u7b80\u5355\u53c8\u901a\u7528\uff0c\u5565\u4efb\u52a1\u90fd\u80fd\u5957\uff0c\u7ed3\u679c\u7b2c\u4e00\u6b21\u62ff\u5b83\u5904\u7406\u56fe\u7247\u76f4\u63a5\u50bb\u4e86\u3002"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u6ca1\u9519\uff0c\u5168\u8fde\u63a5\u7f51\u7edc\u7684\u8bbe\u8ba1\u5c31\u662f\u6bcf\u4e00\u5c42\u7684\u6bcf\u4e2a\u795e\u7ecf\u5143\uff0c\u90fd\u548c\u4e0a\u4e00\u5c42\u7684\u6240\u6709\u795e\u7ecf\u5143\u5168\u90e8\u76f8\u8fde\uff0c\u901a\u7528\u6027\u786e\u5b9e\u5f3a\uff0c\u4f46\u95ee\u9898\u4e5f\u6070\u6070\u51fa\u5728\u8fd9\u91cc\uff1a\u5b83\u5b8c\u5168\u6ca1\u8003\u8651\u8f93\u5165\u6570\u636e\u672c\u8eab\u7684\u7ed3\u6784\u7279\u70b9\u3002\u4f60\u60f3\u4e00\u5f20224\u4e58224\u7684RGB\u56fe\u7247\uff0c\u628a\u50cf\u7d20\u5c55\u5e73\u4e4b\u540e\u8f93\u5165\u7ef4\u5ea6\u5c31\u662f\u5341\u51e0\u4e07\uff0c\u7b2c\u4e00\u5c42\u968f\u4fbf\u8bbe\u4e2a\u51e0\u767e\u9690\u5c42\u795e\u7ecf\u5143\uff0c\u53c2\u6570\u91cf\u76f4\u63a5\u7834\u4ebf\uff0c\u6839\u672c\u6ca1\u6cd5\u8bad\u7ec3\uff0c\u66f4\u522b\u8bf4\u6cdb\u5316\u4e86\u3002"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u5bf9\u554a\uff0c\u5f53\u65f6\u6211\u8dd1\u4e2a\u5c0f\u578b\u624b\u5199\u6570\u5b57\u6570\u636e\u96c6\u90fd\u76f4\u63a5\u628a\u7b14\u8bb0\u672c\u663e\u5b58\u5e72\u7206\uff0c\u540e\u6765\u624d\u77e5\u9053\u56fe\u50cf\u8fd9\u79cd\u6570\u636e\u672c\u8eab\u5c31\u6709\u6781\u5f3a\u7684\u5c40\u90e8\u76f8\u5173\u6027\uff0c\u76f8\u90bb\u7684\u50cf\u7d20\u51d1\u5728\u4e00\u8d77\u624d\u662f\u8fb9\u7f18\u3001\u7eb9\u7406\uff0c\u9694\u5f97\u8fdc\u7684\u50cf\u7d20\u57fa\u672c\u6ca1\u5565\u5173\u7cfb\uff0c\u5168\u8fde\u63a5\u76f8\u5f53\u4e8e\u628a\u8fd9\u4e9b\u7a7a\u95f4\u5173\u8054\u5168\u90e8\u6254\u4e86\uff0c\u6548\u7387\u6781\u4f4e\u3002"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u6240\u4ee5\u5377\u79ef\u795e\u7ecf\u7f51\u7edcCNN\u7684\u51fa\u73b0\uff0c\u624d\u7b97\u662f\u5f7b\u5e95\u89e3\u51b3\u4e86\u56fe\u50cf\u9886\u57df\u7684\u75db\u70b9\uff0c\u5b83\u7684\u6838\u5fc3\u521b\u65b0\u70b9\u5c31\u4e24\u4e2a\uff1a\u5c40\u90e8\u8fde\u63a5\u548c\u53c2\u6570\u5171\u4eab\u3002\u6211\u4eec\u7528\u4e00\u4e2a\u5f88\u5c0f\u7684\u5377\u79ef\u6838\uff0c\u6bd4\u59823\u4e583\u7684\u5c3a\u5bf8\uff0c\u53ea\u548c\u4e0a\u4e00\u5c42\u7684\u5c40\u90e8\u533a\u57df\u505a\u8ba1\u7b97\uff0c\u800c\u4e14\u8fd9\u4e2a\u5377\u79ef\u6838\u4f1a\u5728\u6574\u5f20\u56fe\u7247\u4e0a\u6ed1\u52a8\uff0c\u6240\u6709\u4f4d\u7f6e\u5171\u4eab\u540c\u4e00\u7ec4\u6743\u91cd\uff0c\u8fd9\u4e48\u4e00\u6765\u53c2\u6570\u91cf\u76f4\u63a5\u964d\u5230\u539f\u6765\u7684\u5343\u5206\u4e4b\u4e00\u90fd\u4e0d\u5230\uff0c\u8fd8\u5929\u7136\u81ea\u5e26\u5e73\u79fb\u4e0d\u53d8\u6027\u2014\u2014\u4f60\u628a\u732b\u4ece\u56fe\u7247\u5de6\u4e0a\u89d2\u79fb\u5230\u53f3\u4e0b\u89d2\uff0c\u6a21\u578b\u7167\u6837\u80fd\u8ba4\u51fa\u5b83\u662f\u732b\u3002"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u6211\u5f53\u5e74\u7528\u6700\u65e9\u7684LeNet\u505a\u624b\u5199\u6570\u5b57\u8bc6\u522b\u7684\u65f6\u5019\uff0c\u5c31\u88abCNN\u7684\u6548\u679c\u60ca\u5230\u4e86\uff0c\u51e0\u5c42\u5377\u79ef\u53e0\u4e0b\u6765\uff0c\u7b2c\u4e00\u5c42\u63d0\u53d6\u8fb9\u7f18\u7ebf\u6761\uff0c\u7b2c\u4e8c\u5c42\u63d0\u53d6\u7eb9\u7406\u62d0\u89d2\uff0c\u540e\u9762\u51e0\u5c42\u76f4\u63a5\u80fd\u8bc6\u522b\u51fa\u6570\u5b57\u7684\u6574\u4e2a\u90e8\u4ef6\uff0c\u592a\u795e\u5947\u4e86\u3002\u4e0d\u8fc7CNN\u5904\u7406\u56fe\u50cf\u662f\u795e\uff0c\u78b0\u5230\u5e8f\u5217\u6570\u636e\u5c31\u5b8c\u5168\u6293\u778e\u5bf9\u5427\uff1f"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u4f60\u8bf4\u7684\u592a\u5bf9\u4e86\uff0c\u50cf\u4e00\u53e5\u8bdd\u3001\u4e00\u6bb5\u8bed\u97f3\u8fd9\u79cd\u65f6\u5e8f\u6570\u636e\uff0c\u524d\u540e\u662f\u6709\u65f6\u95f4\u4f9d\u8d56\u5173\u7cfb\u7684\uff0c\u6bd4\u5982\u4f60\u8bfb\u534a\u53e5\u8bdd\u2018\u6211\u6628\u5929\u517b\u7684\u5c0f\u732b\u628a\u676f\u5b50\u6253\u788e\u4e86\u2019\uff0c\u5f97\u7ed3\u5408\u524d\u9762\u7684\u5185\u5bb9\u624d\u77e5\u9053\u540e\u9762\u6307\u4ee3\u7684\u2018\u5b83\u2019\u6307\u7684\u662f\u5c0f\u732b\u4e0d\u662f\u676f\u5b50\uff0cCNN\u7684\u5c40\u90e8\u611f\u53d7\u91ce\u6839\u672c\u6293\u4e0d\u4f4f\u8fd9\u79cd\u957f\u7a0b\u7684\u65f6\u5e8f\u5173\u8054\u3002\u8fd9\u65f6\u5019\u5c31\u8f6e\u5230\u5faa\u73af\u795e\u7ecf\u7f51\u7edcRNN\u767b\u573a\u4e86\uff0c\u5b83\u4e13\u95e8\u8bbe\u8ba1\u4e86\u4e00\u4e2a\u9690\u85cf\u72b6\u6001\uff0c\u4f1a\u968f\u7740\u65f6\u95f4\u6b65\u5411\u540e\u4f20\u9012\uff0c\u76f8\u5f53\u4e8e\u628a\u524d\u9762\u8bfb\u5230\u7684\u4fe1\u606f\u90fd\u2018\u8bb0\u2019\u4e0b\u6765\uff0c\u5e26\u5230\u540e\u9762\u7684\u8ba1\u7b97\u91cc\u3002"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u6211\u65e9\u5e74\u505a\u5de5\u4e1a\u65f6\u5e8f\u9884\u6d4b\u9879\u76ee\u7684\u65f6\u5019\uff0c\u6700\u65e9\u7528\u7684\u5c31\u662f\u6734\u7d20RNN\uff0c\u7ed3\u679c\u53d1\u73b0\u5e8f\u5217\u4e00\u957f\uff0c\u524d\u9762\u7684\u4fe1\u606f\u51e0\u4e4e\u5b8c\u5168\u6ca1\u7559\u4e0b\u6765\uff0c\u9884\u6d4b\u7ed3\u679c\u5b8c\u5168\u4e0d\u5bf9\uff0c\u540e\u6765\u624d\u77e5\u9053\u8fd9\u5c31\u662f\u5927\u5bb6\u8bf4\u7684\u68af\u5ea6\u6d88\u5931\u95ee\u9898\uff0c\u6734\u7d20RNN\u6839\u672c\u8bb0\u4e0d\u4f4f\u51e0\u6b65\u4e4b\u524d\u7684\u5185\u5bb9\u3002\u540e\u6765\u5927\u5bb6\u90fd\u6362\u6210LSTM\u548cGRU\uff0c\u7528\u95e8\u63a7\u673a\u5236\u63a7\u5236\u4fe1\u606f\u7684\u6d41\u5165\u6d41\u51fa\uff0c\u786e\u5b9e\u80fd\u8bb0\u4f4f\u66f4\u957f\u7684\u4e0a\u4e0b\u6587\u4e86\uff0c\u6211\u5f53\u65f6\u8fd8\u4ee5\u4e3a\u8fd9\u5c31\u662f\u65f6\u5e8f\u6a21\u578b\u7684\u7ec8\u6781\u7b54\u6848\u4e86\uff0c\u7ed3\u679c\u8e29\u4e86\u4e2a\u66f4\u5927\u7684\u5751\u3002"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u54e6\uff1f\u4f60\u8e29\u7684\u4ec0\u4e48\u5751\uff0c\u6211\u4f30\u8ba1\u5f88\u591a\u7528\u8fc7LSTM\u505a\u9879\u76ee\u7684\u5f00\u53d1\u8005\u90fd\u78b0\u5230\u8fc7\u7c7b\u4f3c\u7684\u95ee\u9898\u5427\uff1f"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u6211\u5f53\u65f6\u505a\u4e00\u4e2a\u957f\u6587\u672c\u7684\u60c5\u611f\u5206\u7c7b\u9879\u76ee\uff0c\u8f93\u5165\u6587\u672c\u6709\u597d\u51e0\u767e\u4e2a\u8bcd\uff0cLSTM\u8dd1\u51fa\u6765\u7684\u7cbe\u5ea6\u59cb\u7ec8\u4e0a\u4e0d\u53bb\uff0c\u800c\u4e14\u8bad\u7ec3\u901f\u5ea6\u6162\u5230\u6211\u8dd1\u4e00\u8f6e\u8981\u5341\u51e0\u4e2a\u5c0f\u65f6\uff0c\u540e\u6765\u624d\u53cd\u5e94\u8fc7\u6765RNN\u6709\u4e2a\u5929\u751f\u7684\u786c\u4f24\uff1a\u5b83\u5fc5\u987b\u6309\u987a\u5e8f\u4e00\u4e2a\u8bcd\u4e00\u4e2a\u8bcd\u5f80\u540e\u7b97\uff0c\u7b2ct\u6b65\u7684\u8ba1\u7b97\u5fc5\u987b\u7b49\u7b2ct-1\u6b65\u8dd1\u5b8c\u624d\u80fd\u5f00\u59cb\uff0c\u6839\u672c\u6ca1\u6cd5\u505a\u5e76\u884c\u52a0\u901f\uff0c\u4f60\u5c31\u7b97\u6709\u518d\u591aGPU\u6838\u5fc3\u4e5f\u7528\u4e0d\u4e0a\u3002\u800c\u4e14\u54ea\u6015\u662fLSTM\uff0c\u5e8f\u5217\u957f\u5ea6\u62c9\u5230\u4e0a\u5343\uff0c\u524d\u9762\u7684\u4fe1\u606f\u7167\u6837\u8870\u51cf\u5f97\u6ca1\u5f71\uff0c\u957f\u8ddd\u79bb\u4f9d\u8d56\u6839\u672c\u625b\u4e0d\u4f4f\u3002"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u4f60\u8bf4\u7684\u8fd9\u4e2a\u75db\u70b9\uff0c\u5c31\u662f2017\u5e74Transformer\u8bde\u751f\u4e4b\u524d\u6574\u4e2a\u884c\u4e1a\u7684\u5361\u8116\u5b50\u95ee\u9898\uff0c\u76f4\u5230\u6ce8\u610f\u529b\u673a\u5236\u88ab\u5e7f\u6cdb\u5e94\u7528\uff0c\u624d\u5f7b\u5e95\u628a\u8fd9\u4e2a\u6b7b\u5c40\u89e3\u5f00\u3002\u6ce8\u610f\u529b\u673a\u5236\u7684\u6838\u5fc3\u601d\u8def\u7279\u522b\u5de7\u5999\uff1a\u4f60\u5904\u7406\u5e8f\u5217\u91cc\u7684\u4efb\u610f\u4e00\u4e2a\u8bcd\u7684\u65f6\u5019\uff0c\u4e0d\u7528\u7b49\u524d\u9762\u7684\u7ed3\u679c\u4e00\u6b65\u6b65\u4f20\u8fc7\u6765\uff0c\u76f4\u63a5\u8ba9\u5b83\u53bb\u2018\u770b\u2019\u5e8f\u5217\u91cc\u6240\u6709\u5176\u4ed6\u7684\u8bcd\uff0c\u6839\u636e\u4e24\u4e2a\u8bcd\u4e4b\u95f4\u7684\u76f8\u5173\u6027\u5206\u914d\u4e0d\u540c\u7684\u6743\u91cd\uff0c\u76f8\u5173\u5ea6\u9ad8\u7684\u8bcd\u6743\u91cd\u5c31\u62c9\u6ee1\uff0c\u4e0d\u76f8\u5173\u7684\u76f4\u63a5\u5ffd\u7565\u3002"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u54e6\u5bf9\uff0c\u5c31\u662f\u90a3\u4e2aQuery\u3001Key\u3001Value\u7684\u5185\u79ef\u6253\u5206\u673a\u5236\u5bf9\u5427\uff1f\u6211\u4e4b\u524d\u7b2c\u4e00\u6b21\u770b\u61c2\u8fd9\u4e2a\u8bbe\u8ba1\u7684\u65f6\u5019\u76f4\u63a5\u62cd\u5927\u817f\uff0c\u8fd9\u5b8c\u5168\u662f\u964d\u7ef4\u6253\u51fb\u554a\uff0c\u4efb\u610f\u4e24\u4e2a\u4f4d\u7f6e\u7684\u8bcd\u53ef\u4ee5\u76f4\u63a5\u5efa\u7acb\u8054\u7cfb\uff0c\u4f60\u7b2c\u4e00\u5343\u4e2a\u8bcd\u548c\u7b2c\u4e00\u4e2a\u8bcd\u7684\u5173\u8054\uff0c\u4e0d\u9700\u8981\u7ecf\u8fc7\u4e2d\u95f4\u4e5d\u767e\u4e5d\u5341\u516b\u4e2a\u8bcd\u7684\u4f20\u9012\uff0c\u76f4\u63a5\u5c31\u80fd\u7b97\u51fa\u6743\u91cd\uff0c\u957f\u8ddd\u79bb\u4f9d\u8d56\u7684\u95ee\u9898\u76f4\u63a5\u5c31\u6ca1\u4e86\u3002\u800c\u4e14\u6240\u6709\u8ba1\u7b97\u5b8c\u5168\u53ef\u4ee5\u5e76\u884c\uff0cGPU\u7684\u7b97\u529b\u80fd\u767e\u5206\u767e\u5403\u6ee1\uff0c\u8bad\u7ec3\u901f\u5ea6\u76f4\u63a5\u5feb\u51e0\u5341\u4e0a\u767e\u500d\u3002"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "Transformer\u8fd9\u4e2a\u67b6\u6784\uff0c\u5c31\u662f\u628a\u81ea\u6ce8\u610f\u529b\u673a\u5236\u4f5c\u4e3a\u6838\u5fc3\u79ef\u6728\u4e00\u5c42\u5c42\u5806\u53e0\u8d77\u6765\uff0c\u518d\u914d\u4e0a\u591a\u5934\u6ce8\u610f\u529b\u3001\u4f4d\u7f6e\u7f16\u7801\u3001\u524d\u9988\u7f51\u7edc\u3001\u6b8b\u5dee\u8fde\u63a5\u8fd9\u4e9b\u914d\u5957\u7ec4\u4ef6\uff0c\u76f4\u63a5\u628a\u5faa\u73af\u7ed3\u6784\u5b8c\u5168\u7ed9\u629b\u5f03\u4e86\u3002\u5b83\u5b8c\u7f8e\u540c\u65f6\u89e3\u51b3\u4e86RNN\u89e3\u51b3\u4e0d\u4e86\u7684\u957f\u4f9d\u8d56\u95ee\u9898\u548c\u5e76\u884c\u8bad\u7ec3\u95ee\u9898\uff0c\u73b0\u5728\u6211\u4eec\u7528\u5230\u7684\u6240\u6709\u5927\u8bed\u8a00\u6a21\u578b\uff0c\u4eceBERT\u5230GPT\u5168\u7cfb\u5217\uff0c\u5e95\u5c42\u7684\u9aa8\u67b6\u5b8c\u5b8c\u5168\u5168\u90fd\u662fTransformer\u3002"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u4f60\u56de\u5934\u770b\u6574\u4e2a\u67b6\u6784\u6f14\u8fdb\u7684\u8fd9\u6761\u7ebf\uff0c\u903b\u8f91\u7279\u522b\u987a\uff1a\u5168\u8fde\u63a5\u592a\u7b28\u91cd\u6d6a\u8d39\u6570\u636e\u7ed3\u6784\u4fe1\u606f\u2192CNN\u4e13\u95e8\u6293\u7a7a\u95f4\u7ed3\u6784\u9002\u5408\u56fe\u50cf\u2192RNN\u5c1d\u8bd5\u6293\u65f6\u95f4\u5e8f\u5217\u4f46\u6709\u786c\u4f24\u2192\u6700\u540eTransformer\u7528\u6ce8\u610f\u529b\u673a\u5236\u7edf\u4e00\u4e86\u56fe\u50cf\u3001\u6587\u672c\u3001\u8bed\u97f3\u51e0\u4e4e\u6240\u6709\u4efb\u52a1\u7684\u67b6\u6784\uff0c\u6574\u4e2a\u6f14\u8fdb\u8fc7\u7a0b\u672c\u8d28\u4e0a\u5c31\u662f\u5927\u5bb6\u4e00\u76f4\u5728\u8ffd\u6c42\u4e24\u4ef6\u4e8b\uff1a\u600e\u4e48\u66f4\u597d\u5730\u5229\u7528\u4e0d\u540c\u6570\u636e\u7684\u5185\u5728\u7ed3\u6784\uff0c\u600e\u4e48\u8ba9\u6a21\u578b\u8bad\u7ec3\u7684\u6548\u7387\u8d8a\u6765\u8d8a\u9ad8\u3002"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u524d\u9762\u8bb2\u5b8c\u4e86\u8fd9\u4e48\u591a\u7406\u8bba\u548c\u67b6\u6784\u6f14\u8fdb\u7684\u5185\u5bb9\uff0c\u54b1\u4eec\u6700\u540e\u76f4\u63a5\u843d\u5730\u5230\u5927\u5bb6\u5929\u5929\u5199\u7684PyTorch\u5b9e\u64cd\u73af\u8282\uff0c\u6211\u524d\u524d\u540e\u540e\u5199\u8fc7\u51e0\u5341\u4efd\u4e0d\u540c\u573a\u666f\u7684\u8bad\u7ec3\u811a\u672c\uff0c\u53d1\u73b0\u4e0d\u7ba1\u4f60\u7684\u5206\u7c7b\u4efb\u52a1\u591a\u590d\u6742\uff0c\u6240\u6709PyTorch\u9879\u76ee\u7684\u5e95\u5c42\u9aa8\u67b6\u90fd\u662f\u5b8c\u5168\u4e00\u6837\u7684\uff0c\u6838\u5fc3\u5c31\u4e94\u4e2a\u901a\u7528\u7ec4\u4ef6\u3002"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u54e6\uff1f\u8fd9\u6211\u8fd8\u771f\u6ca1\u7279\u610f\u603b\u7ed3\u8fc7\uff0c\u5f88\u591a\u65b0\u624b\u521a\u4e0a\u624b\u7684\u65f6\u5019\u4e1c\u62fc\u897f\u51d1\u6284\u4ee3\u7801\uff0c\u6839\u672c\u610f\u8bc6\u4e0d\u5230\u8fd9\u4e9b\u6a21\u5757\u5176\u5b9e\u662f\u5b8c\u5168\u89e3\u8026\u7684\uff0c\u4f60\u7ed9\u5927\u5bb6\u62c6\u89e3\u4e0b\u8fd9\u4e94\u4e2a\u6838\u5fc3\u90e8\u4ef6\u5206\u522b\u662f\u4ec0\u4e48\uff1f"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u7279\u522b\u597d\u8bb0\uff0c\u7b2c\u4e00\u90e8\u5206\u662f\u6570\u636e\u7ec4\u4ef6\uff0c\u7528Dataset\u81ea\u5b9a\u4e49\u6570\u636e\u96c6\u52a0\u8f7d\u903b\u8f91\uff0c\u518d\u5957\u4e0aDataLoader\u81ea\u52a8\u505a\u5206\u6279\u3001\u6253\u4e71\u987a\u5e8f\uff1b\u7b2c\u4e8c\u90e8\u5206\u662f\u6a21\u578b\u5b9a\u4e49\uff0c\u7ee7\u627fnn.Module\u7c7b\uff0c\u5728\u521d\u59cb\u5316\u65b9\u6cd5\u91cc\u628a\u6240\u6709\u7f51\u7edc\u5c42\u5199\u597d\uff0c\u518d\u5728forward\u65b9\u6cd5\u91cc\u5b9a\u4e49\u524d\u5411\u8ba1\u7b97\u7684\u903b\u8f91\uff1b\u7b2c\u4e09\u90e8\u5206\u662f\u9009\u9002\u914d\u4efb\u52a1\u7684\u635f\u5931\u51fd\u6570\uff0c\u6bd4\u5982\u5206\u7c7b\u4efb\u52a1\u5c31\u7528\u4ea4\u53c9\u71b5\u635f\u5931\uff1b\u7b2c\u56db\u90e8\u5206\u662f\u521d\u59cb\u5316\u4f18\u5316\u5668\uff0c\u628a\u6a21\u578b\u53c2\u6570\u4f20\u8fdb\u53bb\uff0c\u6bd4\u5982\u5927\u5bb6\u5e38\u7528\u7684Adam\uff1b\u6700\u540e\u5c31\u662f\u6700\u6838\u5fc3\u7684\u8bad\u7ec3\u5faa\u73af\uff0c\u5957\u4e24\u5c42\u5faa\u73af\u904d\u5386\u6240\u6709\u6279\u6b21\u6570\u636e\u5c31\u884c\u3002"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u6211\u5e26\u672c\u79d1\u751f\u505a\u8bfe\u7a0b\u8bbe\u8ba1\u7684\u65f6\u5019\uff0c\u53d1\u73b0\u65b0\u624b\u5199\u8bad\u7ec3\u5faa\u73af\u8e29\u7684\u5751\u771f\u7684\u662f\u4e94\u82b1\u516b\u95e8\uff0c\u6709\u6ca1\u6709\u4e24\u4e2a\u6700\u9ad8\u9891\u7684\u5fc5\u4e2dbug\u7ed9\u5927\u5bb6\u63d0\u4e2a\u9192\uff1f"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u8fd8\u771f\u6709\u4e24\u4e2a\uff0c\u51e0\u4e4e90%\u7684\u65b0\u624b\u7b2c\u4e00\u6b21\u5199\u90fd\u4f1a\u8e29\u3002\u7b2c\u4e00\u4e2a\u5c31\u662f\u5fd8\u8bb0\u5728\u6bcf\u8f6e\u53c2\u6570\u66f4\u65b0\u524d\u8c03\u7528optimizer.zero_grad()\u6e05\u7a7a\u4e0a\u4e00\u8f6e\u7684\u68af\u5ea6\uff0c\u68af\u5ea6\u4f1a\u83ab\u540d\u5176\u5999\u7d2f\u79ef\u4e0b\u6765\uff0c\u53c2\u6570\u66f4\u65b0\u5b8c\u5168\u4e0d\u5bf9\uff0c\u8bad\u7ec3\u8dd1\u597d\u51e0\u5929\u635f\u5931\u90fd\u964d\u4e0d\u4e0b\u53bb\uff0c\u65b0\u624b\u67e5bug\u80fd\u67e5\u597d\u51e0\u4e2a\u5c0f\u65f6\u3002\u7b2c\u4e8c\u4e2a\u5c31\u662f\u8bad\u7ec3\u5b8c\u8981\u8bc4\u4f30\u6d4b\u8bd5\u96c6\u7684\u65f6\u5019\uff0c\u5fd8\u8bb0\u8c03\u7528model.eval()\u5207\u6362\u6a21\u5f0f\uff0c\u8fd8\u5f97\u642d\u914d\u4e0atorch.no_grad()\u5173\u95ed\u68af\u5ea6\u8ba1\u7b97\uff0c\u4e0d\u7136\u8bad\u7ec3\u9636\u6bb5\u542f\u7528\u7684Dropout\u8fd8\u5728\u968f\u673a\u5931\u6d3b\u795e\u7ecf\u5143\uff0c\u8bc4\u4f30\u51fa\u6765\u7684\u7cbe\u5ea6\u5ffd\u9ad8\u5ffd\u4f4e\uff0c\u5b8c\u5168\u4e0d\u51c6\uff0c\u5e73\u767d\u65e0\u6545\u6d6a\u8d39\u597d\u591a\u8c03\u8bd5\u65f6\u95f4\u3002"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u592a\u771f\u5b9e\u4e86\uff0c\u6211\u89c1\u8fc7\u597d\u591a\u5b66\u751f\u8dd1\u51fa\u6765\u7684\u7ed3\u679c\u6ce2\u52a8\u5927\u5230\u6839\u672c\u6ca1\u6cd5\u590d\u73b0\uff0c\u67e5\u4e86\u534a\u5929\u5c31\u662f\u5fd8\u4e86\u5207eval\u6a21\u5f0f\u3002\u90a3\u5982\u679c\u8bad\u7ec3\u8fc7\u7a0b\u4e2d\u51fa\u4e86\u5e38\u89c1\u6545\u969c\uff0c\u6709\u6ca1\u6709\u4ec0\u4e48\u5feb\u901f\u5b9a\u4f4d\u7684\u6392\u67e5\u601d\u8def\uff1f"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u6211\u603b\u7ed3\u4e86\u4e09\u4e2a\u6700\u5e38\u89c1\u7684\u573a\u666f\uff1a\u7b2c\u4e00\u5982\u679c\u635f\u5931\u4e00\u76f4\u50f5\u4f4f\u4e0d\u4e0b\u964d\uff0c\u4f18\u5148\u67e5\u5b66\u4e60\u7387\u662f\u4e0d\u662f\u8bbe\u5f97\u592a\u5927\u6216\u8005\u592a\u5c0f\uff0c\u518d\u68c0\u67e5\u8f93\u5165\u6570\u636e\u6709\u6ca1\u6709\u505a\u5f52\u4e00\u5316\uff0c\u6807\u7b7e\u548c\u6837\u672c\u662f\u4e0d\u662f\u5bf9\u9f50\u4e86\uff0c\u8fd9\u51e0\u4e2a\u70b9\u6328\u4e2a\u67e5\u4e00\u904d\u57fa\u672c\u5c31\u80fd\u5b9a\u4f4d\u95ee\u9898\u3002\u7b2c\u4e8c\u5982\u679c\u8bad\u7ec3\u8dd1\u7740\u8dd1\u7740\u635f\u5931\u76f4\u63a5\u53d8\u6210NaN\uff0c\u8981\u4e48\u662f\u5b66\u4e60\u7387\u592a\u5927\u5bfc\u81f4\u68af\u5ea6\u7206\u70b8\uff0c\u8981\u4e48\u662f\u8ba1\u7b97\u635f\u5931\u7684\u65f6\u5019\u4e0d\u5c0f\u5fc3\u78b0\u5230\u4e86log(0)\u8fd9\u7c7b\u6570\u503c\u4e0d\u7a33\u5b9a\u7684\u60c5\u51b5\uff0c\u52a0\u4e2a\u68af\u5ea6\u88c1\u526a\u57fa\u672c\u5c31\u80fd\u89e3\u51b3\u3002\u7b2c\u4e09\u8981\u662f\u8dd1\u7740\u8dd1\u7740GPU\u663e\u5b58\u76f4\u63a5\u70b8\u4e86\uff0c\u7b2c\u4e00\u53cd\u5e94\u5148\u628abatch size\u8c03\u5c0f\u4e00\u534a\uff0c\u5b9e\u5728\u4e0d\u884c\u5c31\u7528\u68af\u5ea6\u7d2f\u79ef\u7684\u65b9\u6cd5\u6a21\u62df\u5927batch\u8bad\u7ec3\uff0c\u4e0d\u7528\u975e\u5f97\u6362\u663e\u5361\u3002"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u6211\u4e4b\u524d\u542c\u4f60\u5728\u6280\u672f\u5206\u4eab\u91cc\u63d0\u8fc7\u4e00\u4e2a\u65b0\u624b\u8c03\u8bd5\u6df1\u5ea6\u5b66\u4e60\u7684\u9ec4\u91d1\u6cd5\u5219\uff0c\u53eb\u300c\u5148\u8fc7\u62df\u5408\u518d\u6b63\u5219\u5316\u300d\uff0c\u5f88\u591a\u5b66\u751f\u542c\u5b8c\u4e4b\u540e\u76f4\u547c\u5c11\u8d70\u4e86\u534a\u5e74\u5f2f\u8def\uff0c\u4f60\u4eca\u5929\u4e5f\u7ed9\u6211\u4eec\u542c\u4f17\u8bb2\u8bb2\u5457\uff1f"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u8fd9\u4e2a\u6cd5\u5219\u771f\u7684\u662f\u6211\u8e29\u4e86\u65e0\u6570\u5751\u603b\u7ed3\u51fa\u6765\u7684\uff0c\u4f60\u521a\u4e0a\u624b\u5199\u5168\u65b0\u7684\u8bad\u7ec3\u811a\u672c\uff0c\u522b\u4e0a\u6765\u5c31\u5806\u4e00\u5806Dropout\u3001\u6570\u636e\u589e\u5f3a\u3001\u6b63\u5219\u5316\u8fd9\u4e9b\u82b1\u6d3b\uff0c\u4f60\u5148\u4ece\u6574\u4e2a\u6570\u636e\u96c6\u91cc\u62bd\u51e0\u5341\u4e2a\u5c0f\u6837\u672c\u51fa\u6765\uff0c\u5565\u9650\u5236\u90fd\u4e0d\u52a0\uff0c\u8ba9\u6a21\u578b\u5f80\u8fd9\u51e0\u5341\u4e2a\u6837\u672c\u4e0a\u786c\u62df\u5408\u3002\u8981\u662f\u6a21\u578b\u8fde\u8fd9\u51e0\u5341\u4e2a\u6837\u672c\u90fd\u6ca1\u6cd5\u505a\u5230\u767e\u5206\u767e\u5206\u7c7b\u6b63\u786e\u3001\u635f\u5931\u964d\u5230\u63a5\u8fd10\uff0c\u90a3\u4e0d\u7528\u60f3\uff0c\u4f60\u7684\u4ee3\u7801\u91cc\u80af\u5b9a\u6709\u4f4e\u7ea7bug\uff0c\u8fde\u6700\u57fa\u7840\u7684\u62df\u5408\u80fd\u529b\u90fd\u6ca1\u6709\uff0c\u540e\u9762\u4f60\u52a0\u518d\u591a\u6280\u5de7\u4e5f\u6ca1\u7528\u3002\u7b49\u4f60\u786e\u8ba4\u5c0f\u6837\u672c\u80fd\u8f7b\u677e\u8fc7\u62df\u5408\uff0c\u8bf4\u660e\u4ee3\u7801\u903b\u8f91\u5b8c\u5168\u6ca1\u95ee\u9898\uff0c\u518d\u6162\u6162\u52a0\u6b63\u5219\u3001\u8c03\u8d85\u53c2\u3001\u6269\u5927\u6570\u636e\u96c6\uff0c\u8c03\u8bd5\u6548\u7387\u76f4\u63a5\u7ffb\u597d\u51e0\u500d\u3002"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u4f60\u770b\u6211\u4eec\u4eca\u5929\u8fd9\u671f\u5185\u5bb9\uff0c\u4ece\u6700\u57fa\u7840\u7684\u673a\u5668\u5b66\u4e60\u5b9a\u4e49\u3001\u6cdb\u5316\u504f\u5dee\u65b9\u5dee\u7684\u5e95\u5c42\u903b\u8f91\uff0c\u4e00\u8def\u7a7f\u900f\u68af\u5ea6\u4e0b\u964d\u548c\u53cd\u5411\u4f20\u64ad\u7684\u9ed1\u7bb1\u539f\u7406\uff0c\u987a\u7740\u65f6\u95f4\u7ebf\u628a\u4ece\u5168\u8fde\u63a5\u5230Transformer\u7684\u67b6\u6784\u6f14\u8fdb\u8109\u7edc\u7406\u5f97\u6e05\u6e05\u695a\u695a\uff0c\u6700\u540e\u8fd8\u843d\u5230\u4e86PyTorch\u5b9e\u64cd\u7684\u8c03\u8bd5\u907f\u5751\u6307\u5357\u4e0a\uff0c\u6574\u6761\u5165\u95e8\u4e3b\u7ebf\u76f4\u63a5\u7ed9\u5927\u5bb6\u4e32\u5f97\u660e\u660e\u767d\u767d\u3002"
  },
  {
    "speaker": "\u6653\u660e",
    "dialogue": "\u6700\u540e\u4e5f\u7ed9\u5927\u5bb6\u7559\u4e2a\u7279\u522b\u7b80\u5355\u7684\u5c0f\u7ec3\u4e60\uff0c\u542c\u5b8c\u8fd9\u671f\u8282\u76ee\u82b1\u4e00\u4e24\u4e2a\u5c0f\u65f6\uff0c\u7528\u6211\u4eec\u4eca\u5929\u8bb2\u7684\u8fd9\u5957\u65b9\u6cd5\uff0c\u8dd1\u901a\u4e00\u4e2a\u624b\u5199\u6570\u5b57\u8bc6\u522b\u7684\u7b80\u5355\u5206\u7c7b\u6a21\u578b\uff0c\u628a\u6574\u4e2a\u4ece\u6570\u636e\u52a0\u8f7d\u5230\u8bad\u7ec3\u8bc4\u4f30\u7684\u5b8c\u6574\u6d41\u7a0b\u8d70\u4e00\u904d\uff0c\u6536\u83b7\u6bd4\u4f60\u5237\u5341\u51e0\u7bc7\u788e\u7247\u5316\u7684\u6559\u7a0b\u90fd\u5927\u3002"
  },
  {
    "speaker": "\u9648\u535a\u58eb",
    "dialogue": "\u4e5f\u6b22\u8fce\u5927\u5bb6\u5728\u6211\u4eec\u7684\u8282\u76ee\u8bc4\u8bba\u533a\uff0c\u5206\u4eab\u4f60\u7b2c\u4e00\u6b21\u8bad\u7ec3\u6df1\u5ea6\u5b66\u4e60\u6a21\u578b\u7684\u65f6\u5019\u8e29\u8fc7\u7684\u5370\u8c61\u6700\u6df1\u7684\u5751\uff0c\u6211\u4eec\u4e5f\u4f1a\u62bd\u9009\u51e0\u4e2a\u5178\u578b\u95ee\u9898\u5728\u4e0b\u671f\u8282\u76ee\u91cc\u7ed9\u5927\u5bb6\u4e13\u95e8\u89e3\u7b54\u3002\u672c\u671f\u5185\u5bb9\u5c31\u5230\u8fd9\u91cc\uff0c\u611f\u8c22\u5927\u5bb6\u6536\u542c\uff0c\u6211\u4eec\u4e0b\u671f\u518d\u89c1\u3002"
  }
]
